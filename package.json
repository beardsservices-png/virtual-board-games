{
  "name": "virtual-board-games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "node server/src/index.js",
    "test": "node tests/rules.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:online": "node tests/online.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
